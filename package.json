{
  "name": "aire-api",
  "version": "2.0.0",
  "description": "Realtime polling API on Cloudflare Workers + Durable Objects + D1.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute aire --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute aire --local --file=./schema.sql",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
